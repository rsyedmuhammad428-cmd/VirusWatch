{
  "_note": "HAND-BUILT SAMPLES, schema-accurate but not generated by a live request (FastAPI is not installable in this build sandbox -- see docs/api_surveillance.md). Field names and types are copied verbatim from app/api/v1/notifications.py's Pydantic models; tests/notifications/ and tests/db/test_notifications_sql.py exercise the underlying SQL and sender-selection logic that produce these shapes.",
  "put_preferences": {
    "request_example": {
      "method": "PUT",
      "path": "/api/v1/me/notifications/preferences",
      "auth": "required (Supabase JWT); role `authenticated`",
      "body": {
        "enabled": true,
        "consent": true,
        "digest_enabled": true,
        "alerts_enabled": true,
        "frequency": "weekly",
        "timezone": "Asia/Karachi",
        "delivery_time": "09:00",
        "weekly_day": 1,
        "monthly_day": 1,
        "minimum_alert_severity": "possible_anomaly",
        "selected_diseases": [
          "dengue",
          "influenza"
        ]
      }
    },
    "response_example": {
      "next_delivery_utc": "2026-11-09T04:00:00Z",
      "timezone": "Asia/Karachi",
      "local_time": "09:00"
    },
    "error_examples": [
      {
        "status": 422,
        "error": {
          "code": "consent_required",
          "message": "Consent is required to enable email delivery.",
          "request_id": "..."
        }
      },
      {
        "status": 409,
        "error": {
          "code": "email_not_verified",
          "message": "Verify your email address first.",
          "request_id": "..."
        }
      }
    ]
  },
  "get_my_notifications": {
    "request_example": {
      "method": "GET",
      "path": "/api/v1/me/notifications",
      "auth": "required (Supabase JWT); role `authenticated`"
    },
    "response_example": {
      "preferences": {
        "enabled": true,
        "digest_enabled": true,
        "alerts_enabled": true,
        "frequency": "weekly",
        "timezone": "Asia/Karachi",
        "local_time": "09:00",
        "weekly_day": 1,
        "monthly_day": 1,
        "minimum_alert_severity": "possible_anomaly",
        "selected_diseases": [
          "dengue",
          "influenza"
        ],
        "email_verified": true
      },
      "recent_history": [
        {
          "id": "7c1b1e2a-2222-4bbb-9999-aaaaaaaaaaaa",
          "notification_type": "digest",
          "subject": "VirusWatch weekly digest - Pakistan",
          "status": "delivered",
          "attempt_count": 1,
          "scheduled_for": "2026-11-02T04:00:00Z",
          "sent_at": "2026-11-02T04:00:12Z",
          "delivered_at": "2026-11-02T04:00:45Z",
          "error_summary": null
        }
      ]
    },
    "note": "Never returns an email's subject body or HTML/text content, only metadata."
  },
  "send_test_notification": {
    "request_example": {
      "method": "POST",
      "path": "/api/v1/me/notifications/test",
      "auth": "required (Supabase JWT); role `authenticated`",
      "body": null
    },
    "response_example": {
      "status": "sent",
      "mode": "dev_redirected",
      "detail": "Test email sent to user@example.com."
    },
    "note": "Carries no real surveillance figures (app/api/v1/notifications.py TEST_TEXT); only proves the preferences -> sender -> delivery-tracking pipeline is wired."
  },
  "unsubscribe": {
    "request_example": {
      "method": "POST",
      "path": "/api/v1/notifications/unsubscribe",
      "auth": "public; the token itself is the credential",
      "body": {
        "token": "7c1b1e2a-2222-4bbb-9999-aaaaaaaaaaaa"
      }
    },
    "response_example": {
      "status_code": 204,
      "body": null
    },
    "note": "Always 204, even for an unknown token, so the endpoint cannot be used to probe which tokens exist."
  },
  "resend_webhook": {
    "request_example": {
      "method": "POST",
      "path": "/api/v1/webhooks/resend",
      "auth": "Svix signature headers (svix-id, svix-timestamp, svix-signature), verified against settings.resend_webhook_secret -- not a user token",
      "body": "raw Resend event payload (see app/notifications/webhook.py parse_event)"
    },
    "response_example": {
      "status_code": 204,
      "body": null
    },
    "error_examples": [
      {
        "status": 401,
        "error": {
          "code": "invalid_webhook_signature",
          "message": "Webhook rejected.",
          "request_id": "..."
        }
      },
      {
        "status": 400,
        "error": {
          "code": "invalid_webhook_payload",
          "message": "Webhook payload not understood.",
          "request_id": "..."
        }
      }
    ]
  }
}
