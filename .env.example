# Copy to .env for local development. NEVER commit real values.
# Every value below is a placeholder.

# development | test | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated explicit frontend origins. Wildcards are rejected.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
FRONTEND_BASE_URL=http://localhost:5173
MAX_REQUEST_BYTES=1048576

# --- Supabase (server side) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Safe for the browser (still subject to RLS). Backend does not need it for DB access.
SUPABASE_ANON_KEY=replace-me
# SERVER ONLY. Bypasses RLS. Never ship to Lovable / the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Only needed for projects still on the legacy HS256 JWT secret.
# Projects using asymmetric signing keys are verified through the JWKS endpoint instead.
SUPABASE_JWT_SECRET=
# Postgres connection string (Project Settings -> Database). Use the pooler for hosted deployments.
SUPABASE_DB_URL=postgresql://postgres:replace-me@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# --- Gemini (Phase 5) ---
GEMINI_API_KEY=replace-me
# Choose from the current official model list; intentionally not defaulted.
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
# Must match the vector(N) column in the migrations (currently 768).
EMBEDDING_DIMENSIONS=768

# --- Resend (Phase 6) ---
RESEND_API_KEY=replace-me
EMAIL_FROM=VirusWatch <alerts@your-verified-domain.example>
RESEND_WEBHOOK_SECRET=replace-me

# --- Ingestion ---
# Identify yourself to data publishers (contact URL or email recommended).
INGESTION_USER_AGENT=VirusWatch-Ingestion/0.1 (+https://your-domain.example/contact)
# ISO 3166-1 alpha-3; must be listed in app/ingestion/countries.py
INGESTION_DEFAULT_COUNTRIES=PAK,USA
INGESTION_TIMEOUT_SECONDS=120
INGESTION_MAX_ATTEMPTS=4
INGESTION_MAX_DOWNLOAD_MB=100
# abort a run if more of the in-scope rows than this are invalid
INGESTION_MAX_REJECT_FRACTION=0.2
